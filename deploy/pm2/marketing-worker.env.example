# Copy outside the release tree; owned by the confirmed nonroot worker UID, 0600.
# A root-owned existing PM2 daemon must use explicit confirmed nonzero worker
# UID/GID in its declaration; never run this worker with root privileges.
# Stage 1 is fully disabled. Populate actual private database URL there only.
DATABASE_URL=
NODE_ENV=production
META_ENVIRONMENT=disabled
META_RUNTIME_ENABLED=false
META_CAPI_ENABLED=false
META_PIXEL_ENABLED=false
TRACKING_ISOLATION_READY=false
# Use the same absolute runtime policy file as the application when configured.
META_POLICY_FILE=
# Actual separately reviewed origins, credentials and matching approvals are
# prerequisites for a later explicitly authorized stage. No historical replay.
STOREFRONT_ORIGIN=
COMMERCE_ORIGIN=
