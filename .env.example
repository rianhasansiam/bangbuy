# Canonical application origin. Use https://bangbuy.net in production.
SITE_URL=http://localhost:3000
# Legacy/client-visible compatibility value; keep it aligned with SITE_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bangbuy

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Optional integrations
IMGBB_API_KEY=replace-with-imgbb-api-key
CUSTOMER_INFO_CHECKER_API=replace-with-courier-api-key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=replace-with-emailjs-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=replace-with-emailjs-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=replace-with-emailjs-public-key

# Demo data is disabled unless explicitly enabled outside production.
ALLOW_DEMO_SEED=false


NODE_ENV=