# =========================================================
# Database
# =========================================================

DATABASE_URL=
# Optional direct PostgreSQL connection for Prisma migration commands. This is
# recommended when DATABASE_URL points at PgBouncer or another transaction
# pooler. Neon URLs are derived automatically when this value is omitted.
DIRECT_URL=

# =========================================================
# Application Environment
# =========================================================
# Development: http://localhost:3000  |  Production: https://yourdomain.com
NODE_ENV=development
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only to run the demo seed script. Never enable in production.
ALLOW_DEMO_SEED=false

# =========================================================
# Authentication 
# =========================================================

AUTH_SECRET=
AUTH_URL=http://localhost:3000


AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# =========================================================
# EmailJS (browser SDK — exposed to the client)
# =========================================================
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# =========================================================
# Third-Party Services (server-only)
# =========================================================

# Fraud/courier check API — https://fraudbd.com
CUSTOMER_INFO_CHECKER_API=


IMGBB_API_KEY=



# =========================================================
# SSLCommerz — Payment Gateway
# =========================================================
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

PAYMENT_RECONCILIATION_SECRET=

# =========================================================
# Airwallex — Payment Gateway
# =========================================================
# Development: keep false until sandbox credentials are configured.
# Production: set true only after live credentials and webhook delivery are ready.
AIRWALLEX_ENABLED=false

# Development: sandbox  |  Production: production
AIRWALLEX_ENV=sandbox

# Airwallex server credentials — https://www.airwallex.com/docs
# Development: use sandbox credentials. Production: inject live credentials
# through your deployment secret store. Never commit real values here.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

# API base URLs — these official hosts are safe to leave as-is.
# AIRWALLEX_ENV selects the active host at runtime.
AIRWALLEX_SANDBOX_API_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_PRODUCTION_API_BASE_URL=https://api.airwallex.com

AIRWALLEX_HTTP_TIMEOUT_MS=10000
AIRWALLEX_WEBHOOK_TOLERANCE_SECONDS=300


# Development: leave empty while Airwallex is disabled.
# Production: inject a strong random value of at least 32 characters.
AIRWALLEX_RECONCILIATION_SECRET=

# Return URL after Hosted Payment Page checkout.
# Production must use the trusted HTTPS BangBuy origin.
AIRWALLEX_RETURN_URL=http://localhost:3000/orders/payment-return

# =========================================================
# Currency Conversion
# =========================================================
# BASE_CURRENCY is intentionally hard-coded to BDT in application code. It is
# not an environment setting, so a deployment cannot relabel canonical prices.
# Server-only ExchangeRate-API credential. Never use a NEXT_PUBLIC_ prefix.
EXCHANGE_RATE_API_KEY=

# Cached FX quotes older than this remain usable but are marked stale.
EXCHANGE_RATE_REFRESH_HOURS=6

# Development only: simulate a visitor country for local currency testing.
# Examples: US, GB, AU, BD. Ignored unless NODE_ENV=development.
DEV_COUNTRY=

# Optional trusted country-header fallback. For a Cloudflare-protected origin,
# set this to CF-IPCountry. For direct Nginx + GeoIP2, use a private header such
# as X-BangBuy-Country and overwrite it at the proxy. See the VPS runbook.
GEO_COUNTRY_HEADER=

# Optional production access to GET /api/debug/country. Generate a separate
# high-entropy Bearer secret; the endpoint needs no secret in development.
CURRENCY_DEBUG_SECRET=

# Use a unique, high-entropy value (recommended: `openssl rand -hex 32`).
CRON_SECRET=

# Legacy Airwallex BDT/USD settlement configuration.
BDT_TO_USD_RATE=
