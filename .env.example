# Configure existing database, authentication, payment and upload values privately.
# Never place credentials in NEXT_PUBLIC_ variables.

# Optional separated catalog/commerce deployment. Use distinct HTTPS hostnames
# with no trailing slash. Leave blank for the existing single-origin deployment.
STOREFRONT_ORIGIN=
COMMERCE_ORIGIN=
# Build-time browser navigation values must match the server origins.
NEXT_PUBLIC_STOREFRONT_ORIGIN=
NEXT_PUBLIC_COMMERCE_ORIGIN=

# Optional Meta Pixel browser ID (public, embedded at build time). Leave empty
# to disable. Only production, non-local, non-automated browsers send events.
NEXT_PUBLIC_META_PIXEL_ID=
