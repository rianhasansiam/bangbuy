# =========================================================
# Database
# =========================================================
DATABASE_URL=

# =========================================================
# Application Environment
# =========================================================
NODE_ENV=
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# Demo data is disabled in production.
ALLOW_DEMO_SEED=false

# =========================================================
# Authentication (NextAuth / Auth.js)
# =========================================================
AUTH_SECRET=
AUTH_URL=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# =========================================================
# EmailJS (browser SDK — exposed to the client)
# =========================================================
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# =========================================================
# Third-Party Services (server-only)
# =========================================================

# https://fraudbd.com
CUSTOMER_INFO_CHECKER_API=

# ImgBB image hosting
#IMGBB_API_KEY="5e34b7836eb51eb7af64bab4c026ba71"
IMGBB_API_KEY=

# =========================================================
# Meta Pixel (browser analytics — public ID)
# =========================================================
# Leave blank to disable tracking. Use the numeric ID from Meta Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=

# =========================================================
# SSLCommerz — Payment Gateway
# =========================================================
# ⚠️  Replace with PRODUCTION credentials before going live.
#     Current values are SANDBOX credentials.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=
PAYMENT_RECONCILIATION_SECRET=

# =========================================================
# Airwallex — Payment Gateway
# =========================================================
AIRWALLEX_ENABLED=

# ⚠️  Switch to "production" and use PRODUCTION credentials
#     from the Airwallex live dashboard before going live.
#     Current values are SANDBOX credentials.
AIRWALLEX_ENV=

#AIRWALLEX_CLIENT_ID="9Tter2lLScKnQYr42s2Agw"
#AIRWALLEX_API_KEY="68d9b07f64c0f1d892e66181e879c09027c33645fdfe9614fde36b7acfeb3cc0f2feb7f92a488ba8cae0f7f352f2ecda"
#AIRWALLEX_WEBHOOK_SECRET="whsec_VMNd2FuMyYEQHAm8Pyp6PmoINUa7WRm1"


AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=


# API base URLs
AIRWALLEX_SANDBOX_API_BASE_URL=
AIRWALLEX_PRODUCTION_API_BASE_URL=

AIRWALLEX_HTTP_TIMEOUT_MS=
AIRWALLEX_WEBHOOK_TOLERANCE_SECONDS=

# Generate a new secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
