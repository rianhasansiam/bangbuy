# Configure existing database, authentication, payment and upload values privately.
# Never place credentials in NEXT_PUBLIC_ variables.

# Optional separated catalog/commerce deployment. Use distinct HTTPS hostnames
# with no trailing slash. Leave blank for the existing single-origin deployment.
STOREFRONT_ORIGIN=
COMMERCE_ORIGIN=
# Build-time browser navigation values must match the server origins.
NEXT_PUBLIC_STOREFRONT_ORIGIN=
NEXT_PUBLIC_COMMERCE_ORIGIN=

# Optional public Pixel IDs, embedded at build time. Rebuild/redeploy changes.
# Format only: NEXT_PUBLIC_META_PIXEL_IDS=111111111111111,222222222222222
# Leave empty to disable. Tracking starts automatically unless a saved preference rejects it.
NEXT_PUBLIC_META_PIXEL_IDS=
# Custom application flag, not a Meta sandbox: allows real development/local/automated traffic.
# Use dedicated test Pixels; saved rejection and URL guards still apply. See docs/meta-pixel.md.
# NODE_ENV=test always stays disabled. Never enable this on a live storefront.
NEXT_PUBLIC_META_PIXEL_TEST_MODE=false
