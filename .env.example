# Existing commerce/database/auth/payment configuration belongs to the deployment.
# This file supplies tracking defaults only and contains no credentials.

# Origins must use distinct hostnames, HTTPS in production and no trailing slash.
# Keep the current legacy commerce origin until session/cart migration is reviewed.
STOREFRONT_ORIGIN=
COMMERCE_ORIGIN=
# Browser navigation constants must match the server origins at build time.
NEXT_PUBLIC_STOREFRONT_ORIGIN=
NEXT_PUBLIC_COMMERCE_ORIGIN=
TRACKING_ISOLATION_READY=false

# All flags are ANDed with the reviewed policy manifest. A Pixel ID is not approval.
META_ENVIRONMENT=disabled
META_PIXEL_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_WORKER_SECRET=

# Runtime kill switch. The manifest is re-read by policy polling and each worker
# cycle; atomically replace it with runtimeEnabled=false to stop new delivery.
META_RUNTIME_ENABLED=false
META_POLICY_FILE=

# Staging uses a separate test dataset. It must differ from the production ID.
META_TEST_PIXEL_ID=
META_TEST_EVENT_CODE=
META_DEBUG=false

# Only the disabled COD definition exists until a collection contract is approved.
META_COD_CONVERSION_DEFINITION=disabled
